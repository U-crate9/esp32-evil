  if (p->rx_ctrl.sig_len < 24) return;
  const uint8_t *m = p->payload;
  uint8_t st = m[0] & 0x0F, ty = (m[0] >> 2) & 0x03;
  const uint8_t *a1 = m + 4, *a2 = m + 10;

  if (ty == 0 && st == 0x04) {
    const uint8_t *ie = m + 24, *end = m + p->rx_ctrl.sig_len;
    while (ie + 2 <= end) {
      uint8_t id = ie[0], ln = ie[1];
      if (id == 0 && ie + 2 + ln <= end) {
