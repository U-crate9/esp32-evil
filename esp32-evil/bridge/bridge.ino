  while (ie + 2 <= end) {
    uint8_t id = ie[0], ln = ie[1];
    if (id == 48 && ln >= 8 && ie + 2 + ln <= end) {
      const uint8_t *b = ie + 2; int q = 6;
      if (q + 2 > ln) return;
      q += 2 + (b[q] | (b[q + 1] << 8)) * 4;
      if (q + 2 > ln) return;
